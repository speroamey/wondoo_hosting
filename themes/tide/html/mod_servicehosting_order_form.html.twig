{% set periods = guest.system_periods %}
{% set pricing = product.pricing %}
{% set tlds = guest.serviceDomain_tlds({"allow_register":1}) %}

<div class="row">
    <div class="col-md-12">
       <h3 class="mb-1">{{ product_details }}</h3>
       <strong>{{ 'Domain configuration'|trans }}</strong>
       <div class="mt-3 mb-3">
          <label class="form-check form-check-inline">
          <input class="form-check-input" type="radio" 
             name="domain[action]" value="owndomain" onclick="selectDomainAction(this);">
          <span class="form-check-label">{{ 'I will use my existing domain and update nameservers'|trans }}</span>
          </label>
          {% if tlds is not empty %}
          <label class="form-check form-check-inline">
          <input class="form-check-input" type="radio" 
             name="domain[action]" value="register" onclick="selectDomainAction(this);">
          <span class="form-check-label">{{ 'I want to register a new domain'|trans }}</span>
          </label>
          {% endif %}
       </div>
       <div id="owndomain" class="domain_action" style="display: none;">
          <fieldset class="form-fieldset">
             <div class="mb-3">
                <div class="row g-2">
                   <div class="col-auto">
                      <input type="text" name="domain[owndomain_sld]" value="{{ request.owndomain_sld }}" placeholder="{{ 'mydomain'|trans }}" class="form-control">
                   </div>
                   <div class="col-auto">
                      <input type="text" name="domain[owndomain_tld]" value="{{ request.owndomain_tld|default('.com') }}" class="form-control">
                   </div>
                </div>
                <p id="own-domain-check-feedback" class="form-text" role="alert" aria-live="polite"></p>
             </div>
          </fieldset>
       </div>
       <div id="register" class="domain_action" style="display: none;">
          <fieldset class="form-fieldset">
             <div class="mb-3">
                <div class="row g-2">
                   <div class="col-auto">
                      <input type="text" name="domain[register_sld]" value="{{ request.register_sld }}" placeholder="{{ 'mydomain'|trans }}" class="form-control">
                   </div>
                   <div class="col-auto">
                      <select name="domain[register_tld]" style="width: 150px" class="form-select">
                         {% for tld in tlds%}
                         <option value="{{ tld.tld}}" label="{{ tld.tld}}">{{ tld.tld}}</option>
                         {% endfor %}
                      </select>
                   </div>
                   <div class="col-auto">
                      <button class="btn btn-primary" type="button" id="domain-check">
                         <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                            <path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0"></path>
                            <path d="M21 21l-6 -6"></path>
                         </svg>
                         {{ 'Check'|trans }}
                      </button>
                   </div>
                </div>
                <p id="domain-check-feedback" class="form-text" role="status" aria-live="polite"></p>
             </div>
             <div id="domain-config" style="display:none;">
                <div class="mb-3">
                   <div class="row g-2">
                      <div class="col-5">
                         <label class="form-label required">{{ 'Period'|trans }}</label>
                         <select class="form-select" name="domain[register_years]"></select>
                      </div>
                   </div>
                </div>
             </div>
          </fieldset>
       </div>
    </div>
</div>

{% set currency = guest.cart_get_currency %}
<script type="text/javascript">
   function selectDomainAction(el) {
      document.querySelectorAll('.domain_action').forEach(function (element) {
         element.style.display = 'none';
      });
      const selectedAction = document.getElementById(el.value);
      if (selectedAction) selectedAction.style.display = 'block';
   }
   
   document.addEventListener('DOMContentLoaded', function() {
      const domainCheck = document.getElementById('domain-check');
         const domainCheckFeedback = document.getElementById('domain-check-feedback');
      domainCheck?.addEventListener('click', function(event) {
         event.preventDefault();
         if (domainCheckFeedback) {
            domainCheckFeedback.textContent = '';
            domainCheckFeedback.className = 'form-text';
         }
         const sldInput = document.querySelector('input[name="domain[register_sld]"]');
         const tldSelect = document.querySelector('select[name="domain[register_tld]"]');
         if (!sldInput || !tldSelect) return;
         const sld = sldInput.value.trim();
         const tld = tldSelect.value;
         FOSSBilling.api.guest.post(
            'servicedomain/check',
            { sld: sld, tld: tld },
            function() {
               setRegistrationPricing(tld);
                  if (domainCheckFeedback) {
                     domainCheckFeedback.textContent = "{{ 'Domain is available.'|trans|e('js') }}";
                     domainCheckFeedback.className = 'form-text text-success';
                  }
               const domainConfig = document.getElementById('domain-config');
               if (domainConfig) domainConfig.style.display = 'block';
            },
            function(error) {
               if (domainCheckFeedback) {
                  domainCheckFeedback.textContent = error.message || "{{ 'Domain availability could not be determined.'|trans|e('js') }}";
                  domainCheckFeedback.className = 'form-text text-danger';
               }
            }
         );
       
           return false;
       });
       
         const addons = document.querySelector('.addons');
         const orderButton = document.getElementById('order-button');
         if (addons && orderButton && getComputedStyle(addons).display === 'none') {
            orderButton.addEventListener('click', function(event) {
               event.preventDefault();
               orderButton.style.display = 'none';
               addons.style.display = 'block';
       
               return false;
           });
       }
       
      document.getElementById('period-selector')?.addEventListener('change', function() {
           var selectedValue = this.value;
           document.querySelectorAll('.period').forEach(function(el) {
               el.style.display = 'none';
           });
           document.querySelectorAll('.period.' + selectedValue).forEach(function(el) {
               el.style.display = 'block';
           });
       });
       
       document.querySelectorAll('.addon-period-selector').forEach(function(el) {
           el.addEventListener('change', function() {
               var r = this.getAttribute('rel');
               document.querySelectorAll('#' + r + ' span').forEach(function(spanEl) {
                   spanEl.style.display = 'none';
               });
               document.querySelectorAll('#' + r + ' span.' + this.value).forEach(function(spanEl) {
                   spanEl.style.display = 'inline';
               });
           });
       });
       
      function setRegistrationPricing(tld) {
         FOSSBilling.api.guest.post('servicedomain/pricing', { tld: tld }, function(result) {
            const yearsSelect = document.querySelector("select[name='domain[register_years]']");
            if (!yearsSelect) return;
            yearsSelect.innerHTML = '';

            for (let years = 1; years <= 5; years++) {
               const price = FOSSBilling.currency.format(
                  Number(result.price_registration) * {{ currency.conversion_rate }} * years,
                  { code: "{{ currency.code|e('js') }}" }
               );
               yearsSelect.appendChild(new Option(years + "{{ ' Year/s @ '|trans|e('js') }}" + price, years));
            }
         }, function(error) {
            FOSSBilling.ui.notify(error.message || "{{ 'Domain pricing could not be retrieved.'|trans|e('js') }}", 'error');
         });
      }
   });
</script>